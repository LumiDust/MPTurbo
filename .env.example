# Copy to .env; the repository already ignores the real .env.
# Container paths stay fixed; these are host bind paths relative to Compose.
TURBOTICK_GAME_DIR=./data/game
TURBOTICK_PROFILE_DIR=./data/profile
TURBOTICK_STATE_DIR=./data/state
TURBOTICK_STEAM_CACHE_DIR=./data/steam-cache
# All four host directories must be writable by this uid:gid during install.
TURBOTICK_UID=10001
TURBOTICK_GID=10001
TURBOTICK_BIND_ADDRESS=0.0.0.0
TURBOTICK_PUBLISHED_PORT=30572
TURBOTICK_GAME_BRANCH=unstable
# Pin the full Version.txt first line when desired; all clients must match it.
TURBOTICK_EXPECTED_GAME_VERSION=1.7
TURBOTICK_CONTROLLER_ONLY=false
TURBOTICK_SAVE=
TURBOTICK_HEALTH_MAX_AGE_SECONDS=30
# Installer only; blank prompts interactively for the account.
STEAM_USER=
# Optional installer transport proxy; use a host reachable from the container.
INSTALL_HTTP_PROXY=
INSTALL_HTTPS_PROXY=
INSTALL_ALL_PROXY=
# Passwords and Guard codes belong exclusively in SteamCMD native prompts.
