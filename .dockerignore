# Allow only runtime scripts, the official installer, license, and the exact
# prebuilt Release Mod. No source builds, game, Harmony, .env, or Steam cache.
**
!Dockerfile
!.dockerignore
!LICENSE
!deploy/
!deploy/container/
!deploy/container/entrypoint.sh
!deploy/container/steamcmd.sh
!deploy/container/container.py
!scripts/
!scripts/steamcmd/
!scripts/steamcmd/install-server.sh
!artifacts/
!artifacts/container-mod/
!artifacts/container-mod/TurboTick/
!artifacts/container-mod/TurboTick/**
.env
**/.env
