# Only the dedicated-server build inputs enter the Docker context.
*
!Dockerfile
!.dockerignore
!Directory.Build.props
!LICENSE
!Networking/
Networking/*
!Networking/*.cs
!Networking/*.csproj
!Server/
Server/*
!Server/Program.cs
!Server/TurboTick.Server.csproj
**/bin/**
**/obj/**
**/Verification/**
